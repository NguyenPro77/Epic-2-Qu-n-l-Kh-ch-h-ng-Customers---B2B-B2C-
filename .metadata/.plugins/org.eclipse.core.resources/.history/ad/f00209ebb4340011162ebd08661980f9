<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib uri="jakarta.tags.core" prefix="c" %>

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hệ thống Quản lý Khách hàng (CRM)</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        body { background-color: #f0f2f5; font-family: 'Inter', sans-serif; }
        .wrapper { padding: 30px 50px; }
        .card { border-radius: 15px; box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.05); }
        .stat-card { border-left: 5px solid #0d6efd; }
        .customer-name { font-weight: 600; }
        .info-text { font-size: 13px; color: #6c757d; }
        .status-badge { font-size: 11px; padding: 5px 12px; border-radius: 50px; }
    </style>
</head>

<body>

<div class="wrapper">

    <div class="d-flex justify-content-between mb-4">
        <h2>📋 Danh sách Lead / Khách hàng</h2>

        <a href="lead-form.jsp" class="btn btn-primary">
            ➕ Thêm Khách Hàng
        </a>
    </div>

    <!-- Dashboard giả -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card stat-card p-3">
                <small>TỔNG LEADS</small>
                <h3 class="text-primary">2,540</h3>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card stat-card p-3" style="border-left-color:green;">
                <small>DOANH THU</small>
                <h3 class="text-success">$152.000</h3>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card stat-card p-3" style="border-left-color:orange;">
                <small>ĐANG TIẾP CẬN</small>
                <h3 class="text-warning">45</h3>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card stat-card p-3" style="border-left-color:red;">
                <small>TỶ LỆ CHỐT</small>
                <h3 class="text-danger">12%</h3>
            </div>
        </div>
    </div>

    <!-- TABLE -->
    <div class="card p-3">

        <table class="table table-hover">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Khách hàng</th>
                    <th>Liên hệ</th>
                    <th>Loại</th>
                    <th>Hạng</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>

                <c:forEach var="l" items="${list}">
                <tr>

                    <td>#${l.id}</td>

                    <td>
                        <div class="customer-name">${l.contactName}</div>
                        <div class="info-text">${l.companyName}</div>
                    </td>

                    <td>
                        <div>${l.phone}</div>
                        <div class="info-text">${l.email}</div>
                    </td>

                    <td>${l.customerType}</td>

                    <td>
                        <span class="badge bg-primary">
                            ${l.customerLevel}
                        </span>
                    </td>

                    <td>
                        <a href="leads?action=delete&id=${l.id}" 
                           class="btn btn-sm btn-danger"
                           onclick="return confirm('Xóa?')">
                            Xóa
                        </a>
                    </td>

                </tr>
                </c:forEach>

            </tbody>
        </table>

    </div>

</div>

</body>
</html>