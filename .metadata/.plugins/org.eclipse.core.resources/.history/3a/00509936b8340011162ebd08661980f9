<%@ page contentType="text/html; charset=UTF-8" %>
<%@ taglib uri="jakarta.tags.core" prefix="c" %>
<%@ page import="java.util.*" %>

<%
    // GIỮ NGUYÊN DỮ LIỆU GIẢ NHƯ CŨ
    List<Map<String, String>> mockList = new ArrayList<>();
    String[][] data = {
        {"1", "KH001", "Nguyễn Văn Anh", "0901234567", "anh.nv@gmail.com", "B2B", "Kim Cương"},
        {"2", "KH002", "Trần Thị Bo", "0911222333", "bo.tran@yahoo.com", "B2C", "Vàng"},
        {"3", "KH003", "Lê Minh Cường", "0988777666", "cuong.le@outlook.com", "B2B", "Bạc"}
    };
    for (String[] row : data) {
        Map<String, String> customer = new HashMap<>();
        customer.put("id", row[0]);
        customer.put("customerCode", row[1]);
        customer.put("name", row[2]);
        customer.put("phone", row[3]);
        customer.put("email", row[4]);
        customer.put("customerType", row[5]);
        customer.put("tierName", row[6]);
        mockList.add(customer);
    }
    request.setAttribute("list", mockList);
%>

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Quản lý Phân loại Khách hàng</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        body { background-color: #f4f7f6; }
        /* Hiệu ứng rê chuột hiện Dropdown (Hover) */
        .dropdown:hover .dropdown-menu { display: block; margin-top: 0; }
        .badge-select { cursor: pointer; transition: 0.3s; padding: 8px 12px; }
        .badge-select:hover { opacity: 0.8; transform: scale(1.05); }
        .table-card { border-radius: 12px; border: none; box-shadow: 0 4px 20px rgba(0,0,0,0.08); }
    </style>
</head>
<body class="py-5">

<div class="container">
    <div class="mb-4 text-center">
        <h2 class="fw-bold text-primary">PHÂN LOẠI ĐỐI TƯỢNG KHÁCH HÀNG</h2>
        <p class="text-muted">Rê chuột vào Nhãn để thay đổi Loại hoặc Hạng</p>
    </div>

    <div class="card table-card">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr class="text-secondary">
                        <th class="ps-4">Mã KH</th>
                        <th>Họ tên</th>
                        <th>Liên hệ</th>
                        <th class="text-center">Đối tượng (B2B/B2C)</th>
                        <th class="text-center">Hạng (Vàng/Bạc/Kim Cương)</th>
                    </tr>
                </thead>
                <tbody>
                    <c:forEach var="c" items="${list}">
                    <tr>
                        <td class="ps-4 fw-bold text-muted">${c.customerCode}</td>
                        <td class="fw-bold">${c.name}</td>
                        <td>
                            <small><i class="bi bi-phone"></i> ${c.phone}</small><br>
                            <small class="text-muted"><i class="bi bi-envelope"></i> ${c.email}</small>
                        </td>

                        <td class="text-center">
                            <div class="dropdown">
                                <span id="type-${c.id}" class="badge rounded-pill badge-select ${c.customerType == 'B2B' ? 'bg-primary' : 'bg-success'}">
                                    ${c.customerType} <i class="bi bi-chevron-down ms-1"></i>
                                </span>
                                <ul class="dropdown-menu shadow">
                                    <li><a class="dropdown-item" href="#" onclick="updateUI('type-${c.id}', 'B2B', 'bg-primary')">B2B</a></li>
                                    <li><a class="dropdown-item" href="#" onclick="updateUI('type-${c.id}', 'B2C', 'bg-success')">B2C</a></li>
                                </ul>
                            </div>
                        </td>

                        <td class="text-center">
                            <div class="dropdown">
                                <span id="tier-${c.id}" class="badge badge-select text-dark 
                                    ${c.tierName == 'Kim Cương' ? 'bg-info' : (c.tierName == 'Vàng' ? 'bg-warning' : 'bg-secondary text-white')}">
                                    ${c.tierName} <i class="bi bi-chevron-down ms-1"></i>
                                </span>
                                <ul class="dropdown-menu shadow">
                                    <li><a class="dropdown-item" href="#" onclick="updateUI('tier-${c.id}', 'Kim Cương', 'bg-info')">Kim Cương</a></li>
                                    <li><a class="dropdown-item" href="#" onclick="updateUI('tier-${c.id}', 'Vàng', 'bg-warning')">Vàng</a></li>
                                    <li><a class="dropdown-item" href="#" onclick="updateUI('tier-${c.id}', 'Bạc', 'bg-secondary text-white')">Bạc</a></li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                    </c:forEach>
                </tbody>
            </table>
        </div>
    </div>
    
    <div class="mt-4 text-center">
        <button class="btn btn-dark shadow-sm" onclick="alert('Dữ liệu đã được lưu tạm thời trên giao diện!')">
            <i class="bi bi-check-circle me-2"></i>Lưu thay đổi
        </button>
    </div>
</div>

<script>
    // Hàm cập nhật giao diện ngay lập tức mà không reload trang
    function updateUI(elementId, newValue, newClass) {
        const el = document.getElementById(elementId);
        el.innerText = newValue;
        
        // Cập nhật lại icon mũi tên
        const icon = document.createElement('i');
        icon.className = "bi bi-chevron-down ms-1";
        el.appendChild(icon);

        // Xóa class màu cũ và thêm màu mới
        el.className = "badge badge-select " + newClass + (elementId.includes('type') ? " rounded-pill" : "");
        
        console.log("Đã cập nhật " + elementId + " thành: " + newValue);
    }
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>