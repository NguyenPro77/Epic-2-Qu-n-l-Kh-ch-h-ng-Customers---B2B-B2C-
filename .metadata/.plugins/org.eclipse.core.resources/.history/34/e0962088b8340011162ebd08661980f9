<%@ page contentType="text/html; charset=UTF-8" %>
<%@ taglib uri="jakarta.tags.core" prefix="c" %>
<%@ page import="java.util.*" %>

<%
    // GIẢ LẬP DỮ LIỆU DỰA TRÊN ĐÚNG CẤU TRÚC FILE SQL CỦA BẠN
    List<Map<String, String>> mockList = new ArrayList<>();
    
    // Dữ liệu mẫu khớp với các trường trong bảng `customers`
    String[][] data = {
        {"1", "KH001", "B2B", "Công ty TNHH Giải Pháp AI", "AI Sol", "0283944556", "contact@aisol.vn", "0102030405", "", "123 Đường ABC, Quận 1, TP.HCM", "Kim Cương"},
        {"2", "KH002", "B2C", "Nguyễn Minh Tuấn", "Tuấn NM", "0901122334", "tuan.nm@gmail.com", "", "079090001234", "456 Đường XYZ, Đà Nẵng", "Vàng"},
        {"3", "KH003", "B2B", "Tập đoàn Công nghệ G-Tech", "G-Tech", "0243111222", "info@gtech.com.vn", "0304050607", "", "Số 1 Liễu Giai, Hà Nội", "Bạc"}
    };

    for (String[] row : data) {
        Map<String, String> c = new HashMap<>();
        c.put("id", row[0]);
        c.put("customer_code", row[1]);
        c.put("customer_type", row[2]); // enum('B2B','B2C')
        c.put("name", row[3]);
        c.put("short_name", row[4]);
        c.put("phone", row[5]);
        c.put("email", row[6]);
        c.put("tax_code", row[7]);        // Dành cho B2B
        c.put("identity_number", row[8]); // Dành cho B2C
        c.put("company_address", row[9]);
        c.put("tier_name", row[10]);      // Lấy từ bảng customer_tiers qua JOIN
        mockList.add(c);
    }
    request.setAttribute("list", mockList);
%>

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Quản lý Chi tiết Khách hàng</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        body { background-color: #f8f9fa; font-size: 0.9rem; }
        .table-main { background: white; border-radius: 10px; box-shadow: 0 0 15px rgba(0,0,0,0.05); }
        .dropdown:hover .dropdown-menu { display: block; margin-top: 0; }
        .badge-interactive { cursor: pointer; padding: 6px 12px; transition: 0.2s; }
        .badge-interactive:hover { transform: translateY(-2px); box-shadow: 0 4px 8px rgba(0,0,0,0.1); }
        .text-truncate-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; max-width: 200px; }
    </style>
</head>
<body class="p-4">

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold"><i class="bi bi-building-gear me-2 text-primary"></i>Hệ thống Quản lý Khách hàng</h3>
        <span class="badge bg-dark">Database: crm | Table: customers</span>
    </div>

    <div class="table-main p-0 overflow-hidden">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-primary">
                <tr>
                    <th class="ps-3">Mã KH</th>
                    <th>Tên khách hàng / Công ty</th>
                    <th>Định danh (MST/CCCD)</th>
                    <th>Liên hệ</th>
                    <th>Địa chỉ công ty</th>
                    <th class="text-center">Loại (B2B/B2C)</th>
                    <th class="text-center">Hạng thành viên</th>
                </tr>
            </thead>
            <tbody>
                <c:forEach var="c" items="${list}">
                <tr>
                    <td class="ps-3 fw-bold text-primary">${c.customer_code}</td>
                    
                    <td>
                        <div class="fw-bold text-dark">${c.name}</div>
                        <small class="text-muted italic">${c.short_name}</small>
                    </td>
                    
                    <td>
                        <c:choose>
                            <c:when test="${not empty c.tax_code}">
                                <span class="small text-secondary">MST:</span> <code>${c.tax_code}</code>
                            </c:when>
                            <c:otherwise>
                                <span class="small text-secondary">CCCD:</span> <code>${c.identity_number}</code>
                            </c:otherwise>
                        </c:choose>
                    </td>

                    <td>
                        <div class="small"><i class="bi bi-telephone text-success me-1"></i>${c.phone}</div>
                        <div class="small"><i class="bi bi-envelope text-danger me-1"></i>${c.email}</div>
                    </td>

                    <td>
                        <div class="small text-truncate-2" title="${c.company_address}">
                            <i class="bi bi-geo-alt text-muted me-1"></i>${c.company_address}
                        </div>
                    </td>

                    <td class="text-center">
                        <div class="dropdown">
                            <span id="type-${c.id}" class="badge rounded-pill badge-interactive ${c.customer_type == 'B2B' ? 'bg-primary' : 'bg-success'}">
                                ${c.customer_type} <i class="bi bi-caret-down-fill ms-1" style="font-size: 0.6rem;"></i>
                            </span>
                            <ul class="dropdown-menu shadow-sm">
                                <li><a class="dropdown-item" href="#" onclick="changeType('type-${c.id}', 'B2B', 'bg-primary')">B2B (Doanh nghiệp)</a></li>
                                <li><a class="dropdown-item" href="#" onclick="changeType('type-${c.id}', 'B2C', 'bg-success')">B2C (Cá nhân)</a></li>
                            </ul>
                        </div>
                    </td>

                    <td class="text-center">
                        <div class="dropdown">
                            <span id="tier-${c.id}" class="badge badge-interactive text-dark shadow-sm
                                ${c.tier_name == 'Kim Cương' ? 'bg-info' : (c.tier_name == 'Vàng' ? 'bg-warning' : 'bg-secondary text-white')}">
                                ${c.tier_name} <i class="bi bi-caret-down-fill ms-1" style="font-size: 0.6rem;"></i>
                            </span>
                            <ul class="dropdown-menu shadow-sm">
                                <li><a class="dropdown-item" href="#" onclick="changeTier('tier-${c.id}', 'Kim Cương', 'bg-info')"><i class="bi bi-gem me-2 text-info"></i>Kim Cương</a></li>
                                <li><a class="dropdown-item" href="#" onclick="changeTier('tier-${c.id}', 'Vàng', 'bg-warning')"><i class="bi bi-star-fill me-2 text-warning"></i>Vàng</a></li>
                                <li><a class="dropdown-item" href="#" onclick="changeTier('tier-${c.id}', 'Bạc', 'bg-secondary text-white')"><i class="bi bi-award me-2"></i>Bạc</a></li>
                            </ul>
                        </div>
                    </td>
                </tr>
                </c:forEach>
            </tbody>
        </table>
    </div>
</div>

<script>
    // Hàm xử lý đổi Loại (Enum B2B/B2C)
    function changeType(id, val, colorClass) {
        const el = document.getElementById(id);
        el.innerText = val;
        el.className = "badge rounded-pill badge-interactive " + colorClass;
        appendIcon(el);
    }

    // Hàm xử lý đổi Hạng
    function changeTier(id, val, colorClass) {
        const el = document.getElementById(id);
        el.innerText = val;
        el.className = "badge badge-interactive text-dark shadow-sm " + colorClass;
        if(colorClass.includes('secondary')) el.classList.remove('text-dark');
        appendIcon(el);
    }

    function appendIcon(el) {
        const icon = document.createElement('i');
        icon.className = "bi bi-caret-down-fill ms-1";
        icon.style.fontSize = "0.6rem";
        el.appendChild(icon);
    }
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>