<%@ page contentType="text/html; charset=UTF-8" %>
<%@ taglib uri="jakarta.tags.core" prefix="c" %>

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Danh sách Khách hàng</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    
    <style>
        /* Thêm chút màu nền dịu mắt cho body */
        body {
            background-color: #f8f9fa;
        }
        /* Bo góc bảng để gọn gàng hơn khi nằm trong Card */
        .table-container {
            overflow-x: auto;
        }
    </style>
</head>

<body>

<div class="container mt-5 mb-5">
    <div class="card shadow-sm border-0">
        
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-3">
            <h5 class="mb-0"><i class="bi bi-people-fill me-2"></i>Danh sách Khách hàng</h5>
            <button class="btn btn-light btn-sm text-primary fw-bold">
                <i class="bi bi-plus-lg me-1"></i>Thêm Mới
            </button>
        </div>

        <div class="card-body p-0 table-container">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-light text-center">
                    <tr>
                        <th>ID</th>
                        <th>Mã KH</th>
                        <th class="text-start">Tên</th>
                        <th class="text-start">Liên hệ</th>
                        <th>Loại</th>
                        <th>Hạng</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>

                <tbody class="text-center">
                    <c:forEach var="c" items="${list}">
                    <tr>
                        <td class="text-muted fw-bold">#${c.id}</td>
                        
                        <td>
                            <span class="badge bg-light text-dark border">${c.customerCode}</span>
                        </td>
                        
                        <td class="text-start fw-medium">${c.name}</td>
                        
                        <td class="text-start">
                            <div><i class="bi bi-telephone-fill text-success me-2"></i>${c.phone}</div>
                            <div class="text-muted small mt-1">
                                <i class="bi bi-envelope-fill text-danger me-2"></i>${c.email}
                            </div>
                        </td>

                        <td>
                            <c:choose>
                                <c:when test="${c.customerType == 'B2B'}">
                                    <span class="badge rounded-pill bg-primary px-3">${c.customerType}</span>
                                </c:when>
                                <c:otherwise>
                                    <span class="badge rounded-pill bg-success px-3">${c.customerType}</span>
                                </c:otherwise>
                            </c:choose>
                        </td>

                        <td>
                            <c:choose>
                                <c:when test="${c.tierName == 'Kim Cương' || c.tierName == 'Diamond'}">
                                    <span class="badge bg-info text-dark"><i class="bi bi-gem me-1"></i>${c.tierName}</span>
                                </c:when>
                                <c:when test="${c.tierName == 'Vàng' || c.tierName == 'Gold'}">
                                    <span class="badge bg-warning text-dark"><i class="bi bi-star-fill me-1"></i>${c.tierName}</span>
                                </c:when>
                                <c:otherwise>
                                    <span class="badge bg-secondary"><i class="bi bi-award me-1"></i>${c.tierName}</span>
                                </c:otherwise>
                            </c:choose>
                        </td>

                        <td>
                            <button class="btn btn-sm btn-outline-primary" title="Chỉnh sửa"><i class="bi bi-pencil-square"></i></button>
                            <button class="btn btn-sm btn-outline-danger" title="Xóa"><i class="bi bi-trash"></i></button>
                        </td>
                    </tr>
                    </c:forEach>
                </tbody>
            </table>
        </div>
        
        <c:if test="${not empty list}">
            <div class="card-footer bg-white text-muted small text-end py-2">
                Tổng số: ${list.size()} khách hàng
            </div>
        </c:if>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>