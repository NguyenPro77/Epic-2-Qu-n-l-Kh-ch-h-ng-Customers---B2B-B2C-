<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Thêm mới Lead</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #f0f2f5; font-family: 'Inter', sans-serif; }
        .form-card { border: none; border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.08); background: #fff; }
        .form-label { font-weight: 600; color: #495057; font-size: 0.9rem; }
        .input-group-text { border: none; background-color: #f8f9fa; color: #adb5bd; }
        .form-control, .form-select { border: 1px solid #e9ecef; padding: 0.6rem 1rem; }
        .form-control:focus { border-color: #0d6efd; box-shadow: none; }
    </style>
</head>
<body>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            
            <div class="mb-4">
                <a href="leads" class="btn btn-link text-decoration-none p-0 text-secondary">
                    <i class="fa-solid fa-chevron-left me-1"></i> Trở lại danh sách
                </a>
            </div>

            <div class="card form-card p-4 p-md-5">
                <div class="text-center mb-5">
                    <h2 class="fw-bold">Thông tin Khách hàng Mới</h2>
                    <p class="text-muted">Vui lòng điền đầy đủ các thông tin để tạo Lead trong hệ thống</p>
                </div>

                <form action="leads?action=insert" method="post">
                    
                    <h5 class="text-primary mb-4 fw-bold border-bottom pb-2">1. Thông tin định danh</h5>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Tên công ty / Website</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa-solid fa-building"></i></span>
                                <input type="text" class="form-control" name="company_name" placeholder="Tên công ty hoặc URL website">
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Tên người liên hệ (*)</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa-solid fa-user"></i></span>
                                <input type="text" class="form-control" name="contact_name" placeholder="Nhập họ và tên khách" required>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Số CCCD / CMND</label>
                            <input type="text" class="form-control" name="citizen_id" placeholder="Citizen ID">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Mã số thuế</label>
                            <input type="text" class="form-control" name="tax_code" placeholder="Tax Code">
                        </div>
                    </div>

                    <h5 class="text-primary mb-4 mt-4 fw-bold border-bottom pb-2">2. Liên hệ & Kinh doanh</h5>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Số điện thoại</label>
                            <input type="text" class="form-control" name="phone" placeholder="VD: 0912...">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Email cá nhân/công ty</label>
                            <input type="email" class="form-control" name="email" placeholder="example@gmail.com">
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Loại khách hàng</label>
                            <select class="form-select" name="customer_type">
                                <option value="B2B">Doanh nghiệp (B2B)</option>
                                <option value="B2C">Cá nhân (B2C)</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Doanh thu dự kiến</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" step="0.01" class="form-control" name="expected_revenue" placeholder="0.00">
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Trạng thái</label>
                            <select class="form-select" name="status">
                                <option value="Mới">Mới</option>
                                <option value="Đang tiếp cận">Đang tiếp cận</option>
                                <option value="Tiềm năng">Tiềm năng</option>
                                <option value="Thất bại">Thất bại</option>
                            </select>
                        </div>
                        <div class="col-12 mb-3">
                            <label class="form-label">Địa chỉ</label>
                            <input type="text" class="form-control" name="address" placeholder="Số nhà, đường, phường, quận...">
                        </div>
                        <div class="col-12 mb-4">
                            <label class="form-label">Mô tả chi tiết / Ghi chú</label>
                            <textarea class="form-control" name="description" rows="3" placeholder="Nhập các đặc điểm lưu ý về khách hàng..."></textarea>
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg fw-bold py-3 shadow">
                            <i class="fa-solid fa-cloud-arrow-up me-2"></i>Lưu thông tin khách hàng
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>