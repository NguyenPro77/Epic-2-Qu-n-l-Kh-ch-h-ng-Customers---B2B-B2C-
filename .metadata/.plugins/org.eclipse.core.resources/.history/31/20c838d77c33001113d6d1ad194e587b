<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib uri="jakarta.tags.core" prefix="c" %>

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Danh sách khách hàng</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #f8f9fa; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .container { max-width: 1000px; margin-top: 40px; }
        .card { border: none; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); }
        .table th { background-color: #f1f3f5; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 0.5px;}
        .badge-b2b { background-color: #0dcaf0; color: #000; }
        .badge-b2c { background-color: #20c997; color: #fff; }
    </style>
</head>
<body>

<div class="container">
    <div class="card p-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="mb-0 text-primary fw-bold">
                <i class="fa-solid fa-address-book me-2"></i>Quản lý khách hàng
            </h3>
            <a href="lead-form.jsp" class="btn btn-primary shadow-sm">
                <i class="fa-solid fa-plus me-1"></i> Thêm mới
            </a>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary">
                    <tr>
                        <th scope="col">ID</th>
                        <th scope="col">Tên Liên Hệ</th>
                        <th scope="col">Loại KH</th>
                        <th scope="col">Hạng</th>
                        <th scope="col" class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    <c:forEach var="l" items="${list}">
                    <tr>
                        <td class="fw-bold text-secondary">#${l.id}</td>
                        <td class="fw-semibold text-dark">${l.contactName}</td>
                        <td>
                            <span class="badge rounded-pill ${l.customerType == 'B2B' ? 'badge-b2b' : 'badge-b2c'}">
                                ${l.customerType}
                            </span>
                        </td>
                        <td>
                            <span class="badge ${l.customerLevel == 'Vang' ? 'bg-warning text-dark' : (l.customerLevel == 'KimCuong' ? 'bg-info' : 'bg-secondary')}">
                                ${l.customerLevel}
                            </span>
                        </td>
                        <td class="text-center">
                            <a href="leads?action=delete&id=${l.id}" class="btn btn-outline-danger btn-sm" onclick="return confirm('Bạn có chắc chắn muốn xóa khách hàng này?');">
                                <i class="fa-solid fa-trash-can me-1"></i> Xóa
                            </a>
                        </td>
                    </tr>
                    </c:forEach>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>