<%@ page contentType="text/html; charset=UTF-8" %>
<%@ taglib uri="jakarta.tags.core" prefix="c" %>

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Quản lý Khách hàng</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        body { background-color: #f8f9fa; font-size: 0.9rem; }
        .table-main { background: white; border-radius: 10px; box-shadow: 0 0 15px rgba(0,0,0,0.05); }

        .table-responsive { overflow: visible !important; }

        .dropdown:hover .dropdown-menu { display: block; margin-top: 0; }

        .badge-interactive {
            cursor: pointer;
            padding: 8px 14px;
            transition: 0.2s;
            min-width: 110px;
            display: inline-block;
        }

        .badge-interactive:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.15);
        }

        .dropdown-menu {
            z-index: 1050;
            border: none;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        }
    </style>
</head>

<body class="p-4">

<div class="container-fluid">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-0">
                <i class="bi bi-building-gear me-2 text-primary"></i>
                Hệ thống Quản lý Khách hàng
            </h3>
            <small class="text-muted">Hiển thị dữ liệu từ bảng customers</small>
        </div>
    </div>

    <!-- TABLE -->
    <div class="table-main">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">

                <thead class="table-primary text-nowrap">
                    <tr>
                        <th class="ps-3">Mã KH</th>
                        <th>Tên khách hàng</th>
                        <th>Liên hệ</th>
                        <th class="text-center">Loại (B2B/B2C)</th>
                        <th class="text-center">Hạng thành viên</th>
                    </tr>
                </thead>

                <tbody>

                    <!-- 🔥 DỮ LIỆU THẬT TỪ SERVLET -->
                    <c:forEach var="c" items="${list}">

                    <tr>

                        <td class="ps-3 fw-bold text-primary">
                            ${c.customerCode}
                        </td>

                        <td>
                            <div class="fw-bold text-dark">${c.name}</div>
                        </td>

                        <td>
                            <div class="small">
                                <i class="bi bi-telephone text-success me-1"></i>${c.phone}
                            </div>
                            <div class="small">
                                <i class="bi bi-envelope text-danger me-1"></i>${c.email}
                            </div>
                        </td>

                        <!-- B2B / B2C -->
                        <td class="text-center">
                            <span class="badge rounded-pill 
                                ${c.customerType == 'B2B' ? 'bg-primary' : 'bg-success'}">
                                ${c.customerType}
                            </span>
                        </td>

                        <!-- VÀNG / BẠC / KIM CƯƠNG -->
                        <td class="text-center">
                            <span class="badge 
                                ${c.tierName == 'Kim Cương' ? 'bg-info' : 
                                 (c.tierName == 'Vàng' ? 'bg-warning text-dark' : 'bg-secondary')}">
                                ${c.tierName}
                            </span>
                        </td>

                    </tr>

                    </c:forEach>

                </tbody>

            </table>
        </div>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>