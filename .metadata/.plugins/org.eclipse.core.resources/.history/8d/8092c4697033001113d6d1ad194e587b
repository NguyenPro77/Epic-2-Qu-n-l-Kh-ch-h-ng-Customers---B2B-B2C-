package com.crm.dao;

import java.sql.*;
import java.util.*;
import com.crm.model.Lead;

public class LeadDAO {

    private String jdbcURL = "jdbc:mysql://localhost:3306/crm";
    private String jdbcUsername = "root";
    private String jdbcPassword = "123456";

    private Connection getConnection() {
        Connection conn = null;
        try {
            Class.forName("com.mysql.cj.jdbc.Driver");
            conn = DriverManager.getConnection(jdbcURL, jdbcUsername, jdbcPassword);
        } catch (Exception e) {
            e.printStackTrace();
        }
        return conn;
    }

    public List<Lead> getAll() {
        List<Lead> list = new ArrayList<>();
        try {
            Connection conn = getConnection();
            PreparedStatement ps = conn.prepareStatement("SELECT * FROM leads");
            ResultSet rs = ps.executeQuery();

            while (rs.next()) {
                list.add(new Lead(
                        rs.getInt("id"),
                        rs.getString("company_name"),
                        rs.getString("contact_name"),
                        rs.getString("phone"),
                        rs.getString("email"),
                        rs.getString("customer_type"),
                        rs.getString("customer_level")
                ));
            }

        } catch (Exception e) {
            e.printStackTrace();
        }
        return list;
    }

    public void insert(Lead l) throws SQLException {
        Connection conn = getConnection();
        PreparedStatement ps = conn.prepareStatement(
                "INSERT INTO leads(company_name, contact_name, phone, email, customer_type, customer_level) VALUES (?,?,?,?,?,?)");

        ps.setString(1, l.getCompanyName());
        ps.setString(2, l.getContactName());
        ps.setString(3, l.getPhone());
        ps.setString(4, l.getEmail());
        ps.setString(5, l.getCustomerType());
        ps.setString(6, l.getCustomerLevel());

        ps.executeUpdate();
    }

    public void delete(int id) throws SQLException {
        Connection conn = getConnection();
        PreparedStatement ps = conn.prepareStatement("DELETE FROM leads WHERE id=?");
        ps.setInt(1, id);
        ps.executeUpdate();
    }
}