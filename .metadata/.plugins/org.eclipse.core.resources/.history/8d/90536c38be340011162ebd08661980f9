<%@ page contentType="text/html; charset=UTF-8" %>
<%@ taglib uri="jakarta.tags.core" prefix="c" %>
<%@ page import="java.util.*" %>

<%
    // Khởi tạo danh sách khách hàng giả lập phong phú hơn (Khớp với crm.sql)
    if (request.getAttribute("list") == null) {
        List<Map<String, String>> mockList = new ArrayList<>();
        String[][] data = {
            {"1","KH001", "Công ty TNHH Giải Pháp AI", "AI Sol", "0283944556", "contact@aisol.vn", "B2B", "Kim Cương", "0102030405", "", "123 Đường ABC, Quận 1, TP.HCM"},
            {"2","KH002", "Nguyễn Minh Tuấn", "Tuấn NM", "0901122334", "tuan.nm@gmail.com", "B2C", "Vàng", "", "079090001234", "456 Đường XYZ, Đà Nẵng"},
            {"3","KH003", "Tập đoàn G-Tech", "G-Tech", "0243111222", "info@gtech.com.vn", "B2B", "Bạc", "0304050607", "", "Số 1 Liễu Giai, Hà Nội"},
            {"4","KH004", "Ngân hàng TMCP Việt Nam", "VietBank", "0283888999", "support@vietbank.com", "B2B", "Kim Cương", "0100112233", "", "78 Láng Hạ, Đống Đa, Hà Nội"},
            {"5","KH005", "Phạm Hoài Danh", "Danh PH", "0944555444", "danh.pham@outlook.com", "B2C", "Bạc", "", "048094005678", "12 Trần Hưng Đạo, Cần Thơ"},
            {"6","KH006", "Cửa hàng Thời trang Blue", "Blue Shop", "0977111222", "blue@fashion.vn", "B2C", "Vàng", "", "052097001122", "89 Lê Lợi, Quận 1, TP.HCM"}
        };
        for (String[] row : data) {
            Map<String, String> c = new HashMap<>();
            c.put("id", row[0]); c.put("customerCode", row[1]); c.put("name", row[2]);
            c.put("shortName", row[3]); c.put("phone", row[4]); c.put("email", row[5]);
            c.put("customerType", row[6]); c.put("tierName", row[7]);
            c.put("taxCode", row[8]); c.put("identityNumber", row[9]);
            c.put("address", row[10]);
            mockList.add(c);
        }
        request.setAttribute("list", mockList);
    }
%>

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Hệ thống Quản lý Khách hàng CRM</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        body { background-color: #f4f7f9; font-family: 'Segoe UI', system-ui, -apple-system, sans-serif; }
        .main-card { background: white; border: none; border-radius: 12px; box-shadow: 0 5px 20px rgba(0,0,0,0.05); }
        
        /* Giải quyết vấn đề dropdown bị che khuất */
        .table-responsive { overflow: visible !important; }
        .table thead th { background-color: #f8f9fa; color: #495057; font-weight: 600; font-size: 0.8rem; text-transform: uppercase; border-top: none; }
        
        .customer-id-badge { font-size: 0.75rem; background-color: #eef2ff; color: #4361ee; border: 1px solid #dbeafe; }
        .form-select-sm { border-radius: 6px; font-size: 0.85rem; border-color: #e2e8f0; cursor: pointer; }
        .form-select-sm:hover { border-color: #4361ee; }
        
        .btn-save-all { position: fixed; bottom: 30px; right: 30px; z-index: 1000; border-radius: 50px; padding: 12px 30px; font-weight: 600; box-shadow: 0 10px 20px rgba(25, 135, 84, 0.3); }
    </style>
</head>

<body class="p-4">

<div class="container-fluid">
    <div class="mb-4">
        <h3 class="fw-bold"><i class="bi bi-people-fill text-primary me-2"></i>Danh sách Khách hàng</h3>
        <p class="text-muted small">Cập nhật phân loại và hạng thành viên trực tiếp trên bảng</p>
    </div>

    <button class="btn btn-success btn-save-all" onclick="alert('Đã đồng bộ toàn bộ thay đổi vào hệ thống!')">
        <i class="bi bi-save2 me-2"></i> LƯU TẤT CẢ THAY ĐỔI
    </button>

    <div class="card main-card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Mã KH</th>
                        <th>Khách hàng / Công ty</th>
                        <th>Mã số thuế / CCCD</th>
                        <th>Thông tin liên hệ</th>
                        <th>Địa chỉ</th>
                        <th style="width: 180px;">Loại đối tượng</th>
                        <th style="width: 180px;">Hạng thành viên</th>
                    </tr>
                </thead>
                <tbody>
                    <c:forEach var="c" items="${list}">
                        <tr>
                            <td class="ps-4">
                                <span class="badge customer-id-badge">${c.customerCode}</span>
                            </td>
                            <td>
                                <div class="fw-bold">${c.name}</div>
                                <small class="text-muted italic">${c.shortName}</small>
                            </td>
                            <td>
                                <c:choose>
                                    <c:when test="${not empty c.taxCode}">
                                        <span class="text-muted small">MST:</span> <code class="fw-bold text-dark">${c.taxCode}</code>
                                    </c:when>
                                    <c:otherwise>
                                        <span class="text-muted small">CCCD:</span> <code class="fw-bold text-dark">${c.identityNumber}</code>
                                    </c:otherwise>
                                </c:choose>
                            </td>
                            <td>
                                <div class="small"><i class="bi bi-telephone-outbound me-2 text-muted"></i>${c.phone}</div>
                                <div class="small"><i class="bi bi-envelope-at me-2 text-muted"></i>${c.email}</div>
                            </td>
                            <td>
                                <div class="small text-muted" style="max-width: 200px;" title="${c.address}">
                                    <i class="bi bi-geo-alt me-1"></i> ${c.address}
                                </div>
                            </td>
                            <td>
                                <select class="form-select form-select-sm" onchange="this.style.backgroundColor='#fff9db'">
                                    <option value="B2B" ${c.customerType == 'B2B' ? 'selected' : ''}>🏢 B2B (Doanh nghiệp)</option>
                                    <option value="B2C" ${c.customerType == 'B2C' ? 'selected' : ''}>👤 B2C (Cá nhân)</option>
                                </select>
                            </td>
                            <td>
                                <select class="form-select form-select-sm" onchange="this.style.backgroundColor='#fff9db'">
                                    <option value="Bạc" ${c.tierName == 'Bạc' ? 'selected' : ''}>🥈 Hạng Bạc</option>
                                    <option value="Vàng" ${c.tierName == 'Vàng' ? 'selected' : ''}>🥇 Hạng Vàng</option>
                                    <option value="Kim Cương" ${c.tierName == 'Kim Cương' ? 'selected' : ''}>💎 Kim Cương</option>
                                </select>
                            </td>
                        </tr>
                    </c:forEach>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>