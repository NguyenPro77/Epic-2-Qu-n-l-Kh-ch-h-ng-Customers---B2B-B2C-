<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib uri="jakarta.tags.core" prefix="c" %>

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Danh sách khách hàng</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { 
            background-color: #f4f7f6; 
            font-family: 'Inter', 'Segoe UI', sans-serif; 
        }
        /* Mở rộng container ra gần full màn hình */
        .dashboard-container { 
            width: 100%; 
            padding: 2rem 3rem; 
        }
        .stat-card {
            border: none;
            border-radius: 12px;
            transition: transform 0.2s;
        }
        .stat-card:hover {
            transform: translateY(-5px);
        }
        .main-card { 
            border: none; 
            border-radius: 15px; 
            box-shadow: 0 5px 20px rgba(0,0,0,0.03); 
            background: #fff;
        }
        /* Làm cho các dòng trong bảng to và thoáng hơn */
        .table > :not(caption) > * > * {
            padding: 1rem 1.5rem;
            vertical-align: middle;
        }
        .table th { 
            background-color: #f8f9fa; 
            text-transform: uppercase; 
            font-size: 0.8rem; 
            font-weight: 600;
            color: #6c757d;
            border-bottom: 2px solid #e9ecef;
        }
        .badge-b2b { background-color: #e0f2fe; color: #0284c7; }
        .badge-b2c { background-color: #dcfce7; color: #16a34a; }
    </style>
</head>
<body>

<div class="dashboard-container">
    
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Khách hàng</h2>
            <p class="text-muted mb-0">Quản lý và theo dõi thông tin đối tác, khách hàng</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary shadow-sm">
                <i class="fa-solid fa-file-pdf me-2"></i>Xuất PDF
            </button>
            <a href="lead-form.jsp" class="btn btn-primary shadow-sm px-4">
                <i class="fa-solid fa-plus me-2"></i>Thêm Mới
            </a>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card stat-card shadow-sm h-100 p-3">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-primary bg-opacity-10 p-3 me-3">
                        <i class="fa-solid fa-users text-primary fs-4"></i>
                    </div>
                    <div>
                        <p class="text-muted mb-0 fs-6">Tổng khách hàng</p>
                        <h3 class="fw-bold mb-0">1,245</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card shadow-sm h-100 p-3">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-info bg-opacity-10 p-3 me-3">
                        <i class="fa-solid fa-building text-info fs-4"></i>
                    </div>
                    <div>
                        <p class="text-muted mb-0 fs-6">Doanh nghiệp (B2B)</p>
                        <h3 class="fw-bold mb-0">850</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card shadow-sm h-100 p-3">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-success bg-opacity-10 p-3 me-3">
                        <i class="fa-solid fa-user text-success fs-4"></i>
                    </div>
                    <div>
                        <p class="text-muted mb-0 fs-6">Cá nhân (B2C)</p>
                        <h3 class="fw-bold mb-0">395</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card shadow-sm h-100 p-3">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-warning bg-opacity-10 p-3 me-3">
                        <i class="fa-solid fa-gem text-warning fs-4"></i>
                    </div>
                    <div>
                        <p class="text-muted mb-0 fs-6">Hạng Kim Cương</p>
                        <h3 class="fw-bold mb-0">120</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card main-card">
        
        <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
            <div class="row align-items-center">
                <div class="col-md-4 mb-3">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                        <input type="text" class="form-control bg-light border-start-0" placeholder="Tìm kiếm theo tên, SĐT, Email...">
                    </div>
                </div>
                <div class="col-md-8 mb-3 d-flex justify-content-md-end gap-2">
                    <select class="form-select w-auto bg-light border-0">
                        <option value="">Tất cả loại KH</option>
                        <option value="B2B">B2B</option>
                        <option value="B2C">B2C</option>
                    </select>
                    <select class="form-select w-auto bg-light border-0">
                        <option value="">Tất cả hạng</option>
                        <option value="Vang">Vàng</option>
                        <option value="Bac">Bạc</option>
                        <option value="KimCuong">Kim Cương</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="card-body px-0 pt-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col" class="ps-4">Mã KH</th>
                            <th scope="col">Tên Liên Hệ</th>
                            <th scope="col">Phân Loại</th>
                            <th scope="col">Hạng Thẻ</th>
                            <th scope="col" class="text-end pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        <c:forEach var="l" items="${list}">
                        <tr>
                            <td class="ps-4 text-muted fw-medium">#${l.id}</td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="rounded-circle bg-secondary bg-opacity-10 d-flex justify-content-center align-items-center me-3" style="width: 40px; height: 40px;">
                                        <i class="fa-solid fa-user text-secondary"></i>
                                    </div>
                                    <div>
                                        <h6 class="mb-0 fw-bold text-dark">${l.contactName}</h6>
                                        <span class="text-muted" style="font-size: 0.85rem;">Chi tiết liên hệ</span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge rounded-pill ${l.customerType == 'B2B' ? 'badge-b2b' : 'badge-b2c'} px-3 py-2">
                                    ${l.customerType}
                                </span>
                            </td>
                            <td>
                                <span class="badge ${l.customerLevel == 'Vang' ? 'bg-warning text-dark' : (l.customerLevel == 'KimCuong' ? 'bg-info' : 'bg-secondary')} px-3 py-2 rounded-pill">
                                    <i class="fa-solid fa-medal me-1"></i> ${l.customerLevel}
                                </span>
                            </td>
                            <td class="text-end pe-4">
                                <a href="#" class="btn btn-sm btn-light text-primary me-2" title="Chỉnh sửa">
                                    <i class="fa-solid fa-pen"></i>
                                </a>
                                <a href="leads?action=delete&id=${l.id}" class="btn btn-sm btn-light text-danger" title="Xóa" onclick="return confirm('Xác nhận xóa khách hàng này?');">
                                    <i class="fa-solid fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                        </c:forEach>
                        
                        <c:if test="${empty list}">
                        <tr>
                            <td class="ps-4 text-muted fw-medium">#1001</td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="rounded-circle bg-secondary bg-opacity-10 d-flex justify-content-center align-items-center me-3" style="width: 40px; height: 40px;">
                                        <i class="fa-solid fa-user text-secondary"></i>
                                    </div>
                                    <div>
                                        <h6 class="mb-0 fw-bold text-dark">Nguyễn Văn A (Mẫu)</h6>
                                        <span class="text-muted" style="font-size: 0.85rem;">0901234567</span>
                                    </div>
                                </div>
                            </td>
                            <td><span class="badge rounded-pill badge-b2b px-3 py-2">B2B</span></td>
                            <td><span class="badge bg-warning text-dark px-3 py-2 rounded-pill"><i class="fa-solid fa-medal me-1"></i> Vàng</span></td>
                            <td class="text-end pe-4">
                                <a href="#" class="btn btn-sm btn-light text-primary me-2"><i class="fa-solid fa-pen"></i></a>
                                <a href="#" class="btn btn-sm btn-light text-danger"><i class="fa-solid fa-trash"></i></a>
                            </td>
                        </tr>
                        </c:if>
                    </tbody>
                </table>
            </div>
            
            <div class="card-footer bg-white border-top-0 py-3 px-4 d-flex justify-content-between align-items-center">
                <span class="text-muted text-sm">Hiển thị 1 đến 10 trong số 1,245 mục</span>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item disabled"><a class="page-link" href="#">Trước</a></li>
                    <li class="page-item active"><a class="page-link" href="#">1</a></li>
                    <li class="page-item"><a class="page-link" href="#">2</a></li>
                    <li class="page-item"><a class="page-link" href="#">3</a></li>
                    <li class="page-item"><a class="page-link" href="#">Sau</a></li>
                </ul>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>