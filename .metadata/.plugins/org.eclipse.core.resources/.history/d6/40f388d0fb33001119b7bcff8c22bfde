<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib uri="jakarta.tags.core" prefix="c" %>

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hệ thống Quản lý Khách hàng (CRM)</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        body { background-color: #f0f2f5; font-family: 'Inter', sans-serif; color: #333; }
        .wrapper { width: 100%; padding: 30px 50px; }
        .card { border: none; border-radius: 15px; box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.05); }
        .stat-card { border-left: 5px solid #0d6efd; transition: all 0.3s; }
        .stat-card:hover { transform: translateY(-5px); }
        .table thead th { background-color: #f8f9fa; color: #6c757d; font-size: 13px; text-transform: uppercase; border-top: none; }
        .customer-name { font-weight: 600; color: #1a1a1a; margin-bottom: 0; }
        .info-text { font-size: 13px; color: #6c757d; }
        .status-badge { font-size: 11px; padding: 5px 12px; border-radius: 50px; font-weight: 600; }
    </style>
</head>
<body>

<div class="wrapper">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">📋 Danh sách Lead / Khách hàng</h2>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#">Hệ thống</a></li>
                    <li class="breadcrumb-item active">Quản lý Leads</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-white border shadow-sm"><i class="fa-solid fa-download me-2"></i>Xuất Excel</button>
            <a href="lead-form.jsp" class="btn btn-primary shadow px-4">
                <i class="fa-solid fa-plus me-2"></i>Thêm Khách Hàng
            </a>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card stat-card p-3 shadow-sm">
                <small class="text-muted fw-bold">TỔNG LEADS</small>
                <h3 class="fw-bold mb-0 text-primary">2,540</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card p-3 shadow-sm" style="border-left-color: #198754;">
                <small class="text-muted fw-bold">DOANH THU DỰ KIẾN</small>
                <h3 class="fw-bold mb-0 text-success">$152.000</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card p-3 shadow-sm" style="border-left-color: #ffc107;">
                <small class="text-muted fw-bold">ĐANG TIẾP CẬN</small>
                <h3 class="fw-bold mb-0 text-warning">45</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card p-3 shadow-sm" style="border-left-color: #dc3545;">
                <small class="text-muted fw-bold">TỶ LỆ CHỐT</small>
                <h3 class="fw-bold mb-0 text-danger">12%</h3>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white py-3 border-0">
            <div class="row align-items-center">
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                        <input type="text" class="form-control bg-light border-0" placeholder="Tìm theo tên, email, sđt...">
                    </div>
                </div>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Thông tin khách hàng</th>
                        <th>Liên hệ & Địa chỉ</th>
                        <th>Doanh thu dự kiến</th>
                        <th>Trạng thái</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    <c:forEach var="l" items="${list}">
                    <tr>
                        <td class="ps-4 fw-medium text-muted">#${l.id}</td>
                        <td>
                            <p class="customer-name text-uppercase">${l.contact_name}</p>
                            <span class="info-text text-primary font-weight-bold">${l.company_name}</span>
                        </td>
                        <td>
                            <div class="info-text"><i class="fa-solid fa-phone me-1"></i> ${l.phone}</div>
                            <div class="info-text"><i class="fa-solid fa-envelope me-1"></i> ${l.email}</div>
                            <div class="info-text text-truncate" style="max-width: 200px;"><i class="fa-solid fa-location-dot me-1"></i> ${l.address}</div>
                        </td>
                        <td>
                            <span class="fw-bold text-dark">$${l.expected_revenue}</span>
                        </td>
                        <td>
                            <span class="status-badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25">
                                ${l.status}
                            </span>
                        </td>
                        <td class="text-end pe-4">
                            <div class="btn-group">
                                <a href="leads?action=edit&id=${l.id}" class="btn btn-sm btn-outline-secondary border-0"><i class="fa-solid fa-pen-to-square"></i></a>
                                <a href="leads?action=delete&id=${l.id}" class="btn btn-sm btn-outline-danger border-0" onclick="return confirm('Xóa khách hàng này?')"><i class="fa-solid fa-trash"></i></a>
                            </div>
                        </td>
                    </tr>
                    </c:forEach>
                </tbody>
            </table>
        </div>
        <div class="card-footer bg-white py-3">
             <p class="text-muted mb-0 small text-center">Hệ thống quản trị nội bộ v1.0</p>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>