<%@ page contentType="text/html; charset=UTF-8" %>
<%@ taglib uri="jakarta.tags.core" prefix="c" %>
<%@ page import="java.util.*" %>

<%
    // 🔥 MOCK DATA (fallback nếu DB rỗng)
    List<Map<String, String>> mockList = new ArrayList<>();

    String[][] data = {
        {"KH001", "Công ty TNHH AI", "0901234567", "ai@gmail.com", "B2B", "Kim Cương"},
        {"KH002", "Nguyễn Văn A", "0911222333", "a@gmail.com", "B2C", "Vàng"},
        {"KH003", "Công ty ABC", "0988888888", "abc@gmail.com", "B2B", "Bạc"}
    };

    for (String[] row : data) {
        Map<String, String> c = new HashMap<>();
        c.put("customerCode", row[0]);
        c.put("name", row[1]);
        c.put("phone", row[2]);
        c.put("email", row[3]);
        c.put("customerType", row[4]);
        c.put("tierName", row[5]);
        mockList.add(c);
    }

    request.setAttribute("mockList", mockList);
%>

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Quản lý Khách hàng</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body { background-color: #f8f9fa; }
        .table-main { background: white; border-radius: 10px; padding: 20px; }
    </style>
</head>

<body class="p-4">

<div class="container-fluid">

    <h3 class="mb-4">📋 Danh sách Khách hàng</h3>

    <div class="table-main">
        <table class="table table-hover">

            <thead class="table-primary">
                <tr>
                    <th>Mã KH</th>
                    <th>Tên</th>
                    <th>Liên hệ</th>
                    <th>Loại</th>
                    <th>Hạng</th>
                </tr>
            </thead>

            <tbody>

            <!-- 🔥 Nếu DB có data -->
            <c:if test="${not empty list}">
                <c:forEach var="c" items="${list}">
                <tr>
                    <td>${c.customerCode}</td>
                    <td>${c.name}</td>
                    <td>
                        ${c.phone} <br>
                        <small>${c.email}</small>
                    </td>
                    <td>
                        <span class="badge bg-info">${c.customerType}</span>
                    </td>
                    <td>
                        <span class="badge bg-warning text-dark">${c.tierName}</span>
                    </td>
                </tr>
                </c:forEach>
            </c:if>

            <!-- 🔥 Nếu DB rỗng → dùng MOCK -->
            <c:if test="${empty list}">
                <c:forEach var="c" items="${mockList}">
                <tr>
                    <td>${c.customerCode}</td>
                    <td>${c.name}</td>
                    <td>
                        ${c.phone} <br>
                        <small>${c.email}</small>
                    </td>
                    <td>
                        <span class="badge bg-secondary">${c.customerType}</span>
                    </td>
                    <td>
                        <span class="badge bg-dark">${c.tierName}</span>
                    </td>
                </tr>
                </c:forEach>
            </c:if>

            </tbody>

        </table>
    </div>

</div>

</body>
</html>