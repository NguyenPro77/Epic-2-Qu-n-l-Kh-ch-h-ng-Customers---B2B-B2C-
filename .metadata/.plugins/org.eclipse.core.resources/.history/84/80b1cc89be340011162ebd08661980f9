<%@ page contentType="text/html; charset=UTF-8" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/functions" prefix="fn" %>
<%@ page import="java.util.*" %>

<%
    // Lấy list từ request (do Controller gửi sang)
    List listAttr = (List) request.getAttribute("list");

    // Nếu list chưa có (null) hoặc không có phần tử nào (empty), ta sẽ nạp dữ liệu giả
    if (listAttr == null || listAttr.isEmpty()) {
        List<Map<String, Object>> mockList = new ArrayList<>();
        
        // Dữ liệu giả phong phú (Khớp hoàn toàn với bảng customers trong crm.sql)
        // Các trường: id, customer_code, customer_type, name, short_name, phone, email, tax_code, identity_number, address, tier_name
        Object[][] dummyData = {
            {101, "KH001", "B2B", "Công ty TNHH Giải Pháp AI", "AI Sol", "0283944556", "contact@aisol.vn", "0102030405", "", "123 Đường ABC, Quận 1, TP.HCM", "Kim Cương"},
            {102, "KH002", "B2C", "Nguyễn Minh Tuấn", "Tuấn NM", "0901122334", "tuan.nm@gmail.com", "", "079090001234", "456 Đường XYZ, Đà Nẵng", "Vàng"},
            {103, "KH003", "B2B", "Tập đoàn G-Tech", "G-Tech", "0243111222", "info@gtech.com.vn", "0304050607", "", "Số 1 Liễu Giai, Hà Nội", "Bạc"},
            {104, "KH004", "B2B", "Ngân hàng TMCP Việt Nam", "VietBank", "0283888999", "support@vietbank.com", "0100112233", "", "78 Láng Hạ, Đống Đa, Hà Nội", "Kim Cương"},
            {105, "KH005", "B2C", "Phạm Hoài Danh", "Danh PH", "0944555444", "danh.pham@outlook.com", "", "048094005678", "12 Trần Hưng Đạo, Cần Thơ"},
            {106, "KH006", "B2B", "Cửa hàng Thời trang Blue", "Blue Shop", "0977111222", "blue@fashion.vn", "052097001122", "", "89 Lê Lợi, Quận 1, TP.HCM", "Vàng"},
            {107, "KH007", "B2C", "Lê Thị Hồng", "Hồng Lê", "0933444555", "hong.le@gmail.com", "", "031095009988", "101 Hải Phòng, Đà Nẵng", "Bạc"}
        };

        for (Object[] row : dummyData) {
            Map<String, Object> c = new HashMap<>();
            c.put("id", row[0]);
            c.put("customer_code", row[1]); //
            c.put("customer_type", row[2]); //
            c.put("name", row[3]);          //
            c.put("short_name", row[4]);    //
            c.put("phone", row[5]);         //
            c.put("email", row[6]);         //
            c.put("tax_code", row[7]);      //
            c.put("identity_number", row[8]); //
            c.put("company_address", row[9]); //
            c.put("tier_name", row.length > 10 ? row[10] : "Bạc"); // Từ bảng customer_tiers
            mockList.add(c);
        }
        request.setAttribute("list", mockList);
    }
%>

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Danh sách Khách hàng - CRM</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        :root { --crm-main: #0d6efd; }
        body { background-color: #f8f9fa; font-family: 'Segoe UI', Tahoma, sans-serif; }
        .main-card { background: white; border-radius: 15px; border: none; box-shadow: 0 8px 30px rgba(0,0,0,0.05); }
        .table-responsive { overflow: visible !important; } /* Quan trọng để dropdown không bị che */
        .table thead th { background-color: #f1f4f9; color: #555; font-size: 0.8rem; text-transform: uppercase; border: none; padding: 15px; }
        .badge-id { background: #e7f0ff; color: #0d6efd; font-weight: 600; padding: 5px 10px; border-radius: 6px; }
        .btn-save-fixed { position: fixed; bottom: 30px; right: 30px; border-radius: 50px; padding: 12px 25px; font-weight: 600; box-shadow: 0 10px 20px rgba(25, 135, 84, 0.3); z-index: 1000; }
        .form-select-sm { cursor: pointer; border-radius: 8px; border-color: #dee2e6; }
        .form-select-sm:hover { border-color: var(--crm-main); }
    </style>
</head>
<body class="p-4">

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark"><i class="bi bi-people-fill me-2 text-primary"></i>Danh sách Khách hàng</h3>
            <p class="text-muted small mb-0">Hệ thống đang hiển thị <b>${fn:length(list)}</b> khách hàng.</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-primary btn-sm"><i class="bi bi-download me-1"></i> Xuất Excel</button>
            <button class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> Thêm mới</button>
        </div>
    </div>

    <button class="btn btn-success btn-save-fixed" onclick="alert('Đã cập nhật dữ liệu thành công!')">
        <i class="bi bi-check2-circle me-2"></i> LƯU TẤT CẢ THAY ĐỔI
    </button>

    <div class="card main-card overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Mã KH</th>
                        <th>Tên Khách hàng / Công ty</th>
                        <th>Định danh (MST/CCCD)</th>
                        <th>Thông tin liên hệ</th>
                        <th>Địa chỉ</th>
                        <th style="width: 160px;">Loại đối tượng</th>
                        <th style="width: 160px;">Hạng thành viên</th>
                    </tr>
                </thead>
                <tbody>
                    <c:forEach var="c" items="${list}">
                        <tr>
                            <td class="ps-4">
                                <span class="badge-id">${c.customer_code}</span>
                            </td>
                            <td>
                                <div class="fw-bold text-dark">${c.name}</div>
                                <div class="text-muted small">${c.short_name}</div>
                            </td>
                            <td>
                                <c:choose>
                                    <c:when test="${not empty c.tax_code}">
                                        <div class="small">MST: <code class="fw-bold">${c.tax_code}</code></div>
                                    </c:when>
                                    <c:otherwise>
                                        <div class="small">CCCD: <code class="fw-bold">${c.identity_number}</code></div>
                                    </c:otherwise>
                                </c:choose>
                            </td>
                            <td>
                                <div class="small"><i class="bi bi-telephone text-muted me-1"></i> ${c.phone}</div>
                                <div class="small text-muted"><i class="bi bi-envelope me-1"></i> ${c.email}</div>
                            </td>
                            <td>
                                <div class="small text-muted text-truncate" style="max-width: 180px;" title="${c.company_address}">
                                    <i class="bi bi-geo-alt me-1"></i> ${c.company_address}
                                </div>
                            </td>
                            <td>
                                <select class="form-select form-select-sm border-0 bg-light" onchange="this.classList.add('bg-warning-subtle')">
                                    <option value="B2B" ${c.customer_type == 'B2B' ? 'selected' : ''}>🏢 B2B</option>
                                    <option value="B2C" ${c.customer_type == 'B2C' ? 'selected' : ''}>👤 B2C</option>
                                </select>
                            </td>
                            <td>
                                <select class="form-select form-select-sm border-0 bg-light" onchange="this.classList.add('bg-warning-subtle')">
                                    <option value="Bạc" ${c.tier_name == 'Bạc' ? 'selected' : ''}>🥈 Bạc</option>
                                    <option value="Vàng" ${c.tier_name == 'Vàng' ? 'selected' : ''}>🥇 Vàng</option>
                                    <option value="Kim Cương" ${c.tier_name == 'Kim Cương' ? 'selected' : ''}>💎 Kim Cương</option>
                                </select>
                            </td>
                        </tr>
                    </c:forEach>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>