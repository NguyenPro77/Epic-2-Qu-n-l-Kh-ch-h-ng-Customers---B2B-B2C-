<%@ page contentType="text/html; charset=UTF-8" %>
<%@ taglib uri="jakarta.tags.core" prefix="c" %>
<%@ page import="java.util.*" %>

<%
    // TẠO DỮ LIỆU GIẢ (MOCK DATA)
    // Trong thực tế, danh sách này sẽ được Controller gửi sang qua request.setAttribute("list", list);
    List<Map<String, String>> mockList = new ArrayList<>();
    
    String[][] data = {
        {"1", "KH001", "Nguyễn Văn Anh", "0901234567", "anh.nv@gmail.com", "B2B", "Kim Cương"},
        {"2", "KH002", "Trần Thị Bo", "0911222333", "bo.tran@yahoo.com", "B2C", "Vàng"},
        {"3", "KH003", "Lê Minh Cường", "0988777666", "cuong.le@outlook.com", "B2B", "Bạc"},
        {"4", "KH004", "Phạm Hoài Danh", "0944555444", "danh.pham@company.com", "B2B", "Kim Cương"},
        {"5", "KH005", "Hoàng Thu Thảo", "0977111222", "thao.hoang@gmail.com", "B2C", "Bạc"},
        {"6", "KH006", "Đỗ Hùng Dũng", "0933444555", "dung.do@fpt.com", "B2C", "Vàng"}
    };

    for (String[] row : data) {
        Map<String, String> customer = new HashMap<>();
        customer.put("id", row[0]);
        customer.put("customerCode", row[1]);
        customer.put("name", row[2]);
        customer.put("phone", row[3]);
        customer.put("email", row[4]);
        customer.put("customerType", row[5]);
        customer.put("tierName", row[6]);
        mockList.add(customer);
    }
    
    request.setAttribute("list", mockList);
%>

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Danh sách Khách hàng - Demo Data</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        body { background-color: #f0f2f5; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .table-container { border-radius: 15px; overflow: hidden; }
        .badge-b2b { background-color: #0d6efd; }
        .badge-b2c { background-color: #198754; }
    </style>
</head>

<body class="py-5">

<div class="container">
    <div class="row mb-4">
        <div class="col">
            <h2 class="fw-bold text-dark"><i class="bi bi-person-badge me-2"></i>Quản lý Khách hàng</h2>
            <p class="text-muted">Task 2.1: Hiển thị và phân loại đối tượng khách hàng</p>
        </div>
    </div>

    <div class="card shadow border-0 table-container">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Mã KH</th>
                        <th>Họ tên</th>
                        <th>Liên hệ</th>
                        <th class="text-center">Đối tượng</th>
                        <th class="text-center">Hạng</th>
                    </tr>
                </thead>
                <tbody>
                    <c:forEach var="c" items="${list}">
                    <tr>
                        <td class="ps-4 text-muted fw-bold">#${c.id}</td>
                        <td><code class="fw-bold">${c.customerCode}</code></td>
                        <td class="fw-bold">${c.name}</td>
                        <td>
                            <div class="small"><i class="bi bi-phone me-1"></i>${c.phone}</div>
                            <div class="small text-muted"><i class="bi bi-envelope me-1"></i>${c.email}</div>
                        </td>
                        
                        <td class="text-center">
                            <c:choose>
                                <c:when test="${c.customerType == 'B2B'}">
                                    <span class="badge badge-b2b px-3">Doanh nghiệp (B2B)</span>
                                </c:when>
                                <c:otherwise>
                                    <span class="badge badge-b2c px-3">Cá nhân (B2C)</span>
                                </c:otherwise>
                            </c:choose>
                        </td>

                        <td class="text-center">
                            <c:choose>
                                <c:when test="${c.tierName == 'Kim Cương'}">
                                    <span class="badge bg-info text-dark shadow-sm">
                                        <i class="bi bi-gem me-1"></i>Kim Cương
                                    </span>
                                </c:when>
                                <c:when test="${c.tierName == 'Vàng'}">
                                    <span class="badge bg-warning text-dark shadow-sm">
                                        <i class="bi bi-star-fill me-1"></i>Vàng
                                    </span>
                                </c:when>
                                <c:otherwise>
                                    <span class="badge bg-secondary shadow-sm">
                                        <i class="bi bi-award me-1"></i>Bạc
                                    </span>
                                </c:otherwise>
                            </c:choose>
                        </td>
                    </tr>
                    </c:forEach>
                </tbody>
            </table>
        </div>
        <div class="card-footer bg-light py-3">
            <small class="text-muted">Hiển thị dữ liệu giả định cho mục đích demo giao diện.</small>
        </div>
    </div>
</div>

</body>
</html>