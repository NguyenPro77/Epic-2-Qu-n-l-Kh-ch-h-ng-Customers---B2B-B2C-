<%@ page contentType="text/html; charset=UTF-8" %>
<%@ taglib uri="jakarta.tags.core" prefix="c" %>
<%@ page import="java.util.*" %>

<%
    // GIỮ NGUYÊN DỮ LIỆU GIẢ ĐỂ TEST
    List<Map<String, String>> mockList = new ArrayList<>();
    String[][] data = {
        {"1", "KH001", "B2B", "Công ty TNHH Giải Pháp AI", "AI Sol", "0283944556", "contact@aisol.vn", "0102030405", "", "123 Đường ABC, Quận 1, TP.HCM", "Kim Cương"},
        {"2", "KH002", "B2C", "Nguyễn Minh Tuấn", "Tuấn NM", "0901122334", "tuan.nm@gmail.com", "", "079090001234", "456 Đường XYZ, Đà Nẵng", "Vàng"},
        {"3", "KH003", "B2B", "Tập đoàn Công nghệ G-Tech", "G-Tech", "0243111222", "info@gtech.com.vn", "0304050607", "", "Số 1 Liễu Giai, Hà Nội", "Bạc"}
    };
    for (String[] row : data) {
        Map<String, String> c = new HashMap<>();
        c.put("id", row[0]); c.put("customer_code", row[1]); c.put("customer_type", row[2]);
        c.put("name", row[3]); c.put("short_name", row[4]); c.put("phone", row[5]);
        c.put("email", row[6]); c.put("tax_code", row[7]); c.put("identity_number", row[8]);
        c.put("company_address", row[9]); c.put("tier_name", row[10]);
        mockList.add(c);
    }
    request.setAttribute("list", mockList);
%>

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Quản lý Khách hàng</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        body { background-color: #f8f9fa; font-size: 0.9rem; }
        .table-main { background: white; border-radius: 10px; box-shadow: 0 0 15px rgba(0,0,0,0.05); }
        
        /* FIX LỖI BỊ CHE: Đảm bảo dropdown hiển thị tràn ra ngoài bảng */
        .table-responsive { overflow: visible !important; }
        
        .dropdown:hover .dropdown-menu { display: block; margin-top: 0; }
        .badge-interactive { cursor: pointer; padding: 8px 14px; transition: 0.2s; min-width: 110px; display: inline-block; }
        .badge-interactive:hover { transform: translateY(-2px); box-shadow: 0 4px 8px rgba(0,0,0,0.15); }
        
        /* Chỉnh khoảng cách để dropdown không bị dính vào nhãn */
        .dropdown-menu { z-index: 1050; border: none; box-shadow: 0 10px 30px rgba(0,0,0,0.1); }
    </style>
</head>
<body class="p-4">

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-0"><i class="bi bi-building-gear me-2 text-primary"></i>Hệ thống Quản lý Khách hàng</h3>
            <small class="text-muted">Database: crm | Table: customers</small>
        </div>
        <button class="btn btn-success px-4 fw-bold shadow-sm" onclick="saveChanges()">
            <i class="bi bi-cloud-arrow-up-fill me-2"></i>LƯU THAY ĐỔI
        </button>
    </div>

    <div class="table-main">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-primary text-nowrap">
                    <tr>
                        <th class="ps-3">Mã KH</th>
                        <th>Tên khách hàng / Công ty</th>
                        <th>Định danh (MST/CCCD)</th>
                        <th>Liên hệ</th>
                        <th>Địa chỉ công ty</th>
                        <th class="text-center">Loại (B2B/B2C)</th>
                        <th class="text-center">Hạng thành viên</th>
                    </tr>
                </thead>
                <tbody>
                    <c:forEach var="c" items="${list}">
                    <tr>
                        <td class="ps-3 fw-bold text-primary">${c.customer_code}</td>
                        <td>
                            <div class="fw-bold text-dark">${c.name}</div>
                            <small class="text-muted">${c.short_name}</small>
                        </td>
                        <td>
                            <c:choose>
                                <c:when test="${not empty c.tax_code}">
                                    <span class="small text-secondary">MST:</span> <code>${c.tax_code}</code>
                                </c:when>
                                <c:otherwise>
                                    <span class="small text-secondary">CCCD:</span> <code>${c.identity_number}</code>
                                </c:otherwise>
                            </c:choose>
                        </td>
                        <td>
                            <div class="small text-nowrap"><i class="bi bi-telephone text-success me-1"></i>${c.phone}</div>
                            <div class="small text-nowrap"><i class="bi bi-envelope text-danger me-1"></i>${c.email}</div>
                        </td>
                        <td>
                            <div class="small text-muted" style="max-width: 250px;">
                                <i class="bi bi-geo-alt me-1"></i>${c.company_address}
                            </div>
                        </td>

                        <td class="text-center">
                            <div class="dropdown">
                                <span id="type-${c.id}" class="badge rounded-pill badge-interactive ${c.customer_type == 'B2B' ? 'bg-primary' : 'bg-success'}">
                                    ${c.customer_type} <i class="bi bi-chevron-down ms-1"></i>
                                </span>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="updateUI('type-${c.id}', 'B2B', 'bg-primary')">B2B</a></li>
                                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="updateUI('type-${c.id}', 'B2C', 'bg-success')">B2C</a></li>
                                </ul>
                            </div>
                        </td>

                        <td class="text-center">
                            <div class="dropdown">
                                <span id="tier-${c.id}" class="badge badge-interactive text-dark 
                                    ${c.tier_name == 'Kim Cương' ? 'bg-info' : (c.tier_name == 'Vàng' ? 'bg-warning' : 'bg-secondary text-white')}">
                                    ${c.tier_name} <i class="bi bi-chevron-down ms-1"></i>
                                </span>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="updateUI('tier-${c.id}', 'Kim Cương', 'bg-info')">Kim Cương</a></li>
                                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="updateUI('tier-${c.id}', 'Vàng', 'bg-warning')">Vàng</a></li>
                                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="updateUI('tier-${c.id}', 'Bạc', 'bg-secondary text-white')">Bạc</a></li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                    </c:forEach>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    function updateUI(id, val, colorClass) {
        const el = document.getElementById(id);
        el.innerText = val;
        
        // Cập nhật class màu
        el.className = "badge badge-interactive " + colorClass + (id.includes('type') ? " rounded-pill" : " text-dark");
        if(colorClass.includes('secondary')) el.classList.remove('text-dark');

        // Thêm lại icon mũi tên
        const icon = document.createElement('i');
        icon.className = "bi bi-chevron-down ms-1";
        el.appendChild(icon);
    }

    function saveChanges() {
        // Trong thực tế, bạn sẽ dùng Ajax để gửi dữ liệu về Database
        alert("✅ Đã lưu thay đổi vào hệ thống (giả lập)!");
    }
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>